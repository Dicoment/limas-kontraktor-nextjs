generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ONGOING
  COMPLETED
}

enum TestimonialPlatform {
  MANUAL
  SOCIAL_MEDIA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String        @db.Text
  location       String?
  client         String?
  limasRole      String?       @map("limas_role")
  coverImage     String?       @map("cover_image")
  gallery        Json?         @default("[]")
  status         ProjectStatus @default(DRAFT)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  projectTeams     ProjectTeam[]
  testimonials     Testimonial[]
  leadsLogs        LeadsLog[]
  categoryProjects CategoryProject[]

  @@map("projects")
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        String    @db.Text
  excerpt        String?   @db.Text
  coverImage     String?   @map("cover_image")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  published      Boolean   @default(false)
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  blogPostCategories BlogPostCategory[]
  blogPostTags       BlogPostTag[]

  @@map("blog_posts")
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String   @db.Text
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model Team {
  id           String   @id @default(cuid())
  name         String
  position     String?
  bio          String?  @db.Text
  avatar       String?
  email        String?
  phone        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projectTeams ProjectTeam[]

  @@map("teams")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  blogPostCategories BlogPostCategory[]
  categoryProjects   CategoryProject[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blogPostTags BlogPostTag[]

  @@map("tags")
}

model Testimonial {
  id          String              @id @default(cuid())
  clientName  String
  content     String              @db.Text
  rating      Int?
  platform    TestimonialPlatform @default(MANUAL)
  sourceUrl   String?
  avatar      String?
  published   Boolean             @default(false)
  projectId   String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id])

  @@map("testimonials")
}

model LeadsLog {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  message   String?  @db.Text
  projectId String?
  pageUrl   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id])

  @@map("leads_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ProjectTeam {
  id        String   @id @default(cuid())
  projectId String
  teamId    String
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  projEntry Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamEntry Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@map("project_teams")
}

model BlogPostCategory {
  id         String   @id @default(cuid())
  blogPostId String
  categoryId String
  createdAt  DateTime @default(now()) @map("created_at")

  catEntry  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  postEntry BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, categoryId])
  @@map("blog_post_categories")
}

model BlogPostTag {
  id         String   @id @default(cuid())
  blogPostId String
  tagId      String
  createdAt  DateTime @default(now()) @map("created_at")

  tagEntry  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  postEntry BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, tagId])
  @@map("blog_post_tags")
}

model CategoryProject {
  id         String   @id @default(cuid())
  categoryId String
  projectId  String
  createdAt  DateTime @default(now()) @map("created_at")

  catEntry  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projEntry Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@map("category_projects")
}